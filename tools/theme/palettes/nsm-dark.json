{
  "name": "NSM Dark",
  "_README": [
    "About a dozen decisions. build_theme.py derives the other ~380 entries from",
    "these, keeping the stock theme's lightness relationships so contrast and",
    "legibility survive the recolour.",
    "",
    "'overrides' are the entries whose meaning we actually know - set those by",
    "hand. Everything else is derived. Add an override whenever you find an entry",
    "the derivation gets wrong; that is how this file grows.",
    "",
    "Colours are plain #RRGGBB. The suite's own language is used throughout:",
    "green = structure, amber = delivery, violet = performance, teal = look."
  ],

  "palette": {
    "accent":  "#8a5cf0",
    "neutral": "#151922",
    "bg":      "#0d0f14",
    "surface": "#151922",
    "arrange": "#12151c",
    "text":    "#eef1f6",
    "muted":   "#8b93a3"
  },

  "tint": {
    "hue_pull": 0.72,
    "saturation": 0.85,
    "saturation_floor": 0.12,
    "neutral_pull": 0.55,
    "treat_as_neutral_below": 0.10
  },

