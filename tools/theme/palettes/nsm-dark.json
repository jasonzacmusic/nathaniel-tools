    "col_toolbar_frame": "#252b36",

    "col_main_text":     "#eef1f6",
    "col_main_text2":    "#8b93a3",
    "col_tl_fg":         "#8b93a3",
    "col_tl_bg":         "#0d0f14",

    "col_cursor":        "#8a5cf0",
